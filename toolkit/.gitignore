# Travels with the toolkit when it is copied into a project as video/.
# Everything here is regenerated by pnpm install, pnpm render, pnpm assemble or pnpm example.

node_modules/

# Render output (re-created by pnpm render / pnpm render:all / pnpm check)
clips/
stills/

# Final video and its subtitle file (pnpm assemble / pnpm captions)
*.mp4
*.srt

# Measured word times (pnpm align) – regenerated from the audio
audio/*.words.json
examples/audio/*.words.json

# Example project outputs (pnpm example)
examples/audio/*.mp3
examples/audio/*.wav
examples/shared/
examples/clips/
examples/stills/

# OS and editor noise
.DS_Store
Thumbs.db
